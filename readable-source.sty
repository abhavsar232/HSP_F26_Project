\RequirePackage{mathtools}
\RequirePackage{unicode-math}
\RequirePackage{braket}



% Renames
    % Shortenings
    \newcommand{\new}{\newcommand}
    \new{\phant}{\phantom}
    \new{\op}{\operatorname}
    % Greek
    \new{\∏}{\Pi}
    \new{\𝜋}{\pi}
    \new{\𝜇}{\mu}
    \new{\𝜆}{\lambda}
    \new{\𝜓}{\psi}
    \new{\𝜑}{\varphi}
    \new{\𝜌}{\rho}

\new{\→}{\rightarrow}
\new{\⧎}{\proj}
\new{\⟗}{\ketbra}
\new{\◊}{\Braket}
\new{\⧏}{\Bra}
\new{\⧐}{\Ket}
\new{\√}{\sqrt}
\new{\∞}{\infty}
\new{\†}{^\dag}
\new{\∆}{\Delta}
\new{\•}{\item}
\new{\≤}{\le}
\new{\≥}{\ge}
\new{\÷}{\frac}
\new{\ˆ}{\widehat}

%refactors
\new{\cosp}[1]{\cos{\p{#1}}}
\new{\ƒ}[2]{\mathop{{}#1\!}{#2}}
\new{\∑}[2]{\sum_{#1}^{#2}}
\new{\∫}[2]{\int_{#1}^{#2}}
\new{\re}[1]{\op{Re}\p{#1}}
\new{\Tr}[1]{\op{Tr}\p{#1}}
\new{\ketbra}[2]{\Ket{#1}\!\Bra{#2}}
\new{\proj}[1]{\ketbra{#1}{#1}}

\new{\be}[2]{\begin{#1}#2\end{#1}}
    %begin-end
    \new{\eq}[1]{\begin{equation}#1\end{equation}}
    \new{\eqalign}[1]{\begin{align}#1\end{align}}
    \new{\eqaligned}[1]{\eq{\begin{aligned}#1\end{aligned}}}
    \new{\alignedeq}[1]{\begin{aligned}#1\end{aligned}}
    \new{\eqalignat}[2]{\begin{alignat}{#1}#2\end{alignat}}
    \new{\eqmultiline}[1]{\begin{multiline}#1\end{multiline}}
    \new{\eqsplit}[1]{\eq{\begin{split}#1\end{split}}}
    \new{\spliteq}[1]{\begin{split}#1\end{split}}
    \new{\mat}[1]{\begin{bmatrix}#1\end{bmatrix}}
    \new{\pmat}[1]{\begin{pmatrix}#1\end{pmatrix}}
    \new{\pw}[1]{\begin{dcases}#1\end{dcases}}
    
\new{\lr}[3]{\left#1#3\right#2}
    %left-right
    \new{\norm}[1]{\lr{\lVert}{\rVert}{#1}}
    \new{\abs}[1]{\lr{\lvert}{\rvert}{#1}}
    \new{\B}[1]{\lr{\{}{\}}{#1}}
    \new{\p}[1]{\lr{(}{)}{#1}}
    \new{\pl}[1]{\lr{(}{.}{#1}}
    \new{\pr}[1]{\lr{.}{)}{#1}}
    \new{\rangeco}[1]{\lr{[}{)}{#1}}
    \new{\rangec}[1]{\lr{[}{]}{#1}}
    \new{\rangeoc}[1]{\lr{(}{]}{#1}}
    \new{\rangeo}[1]{\p[#1]}
    \new{\grp}[1]{\lr{.}{.}{#1}}

% Macros
\new{\𝑒}{e^}